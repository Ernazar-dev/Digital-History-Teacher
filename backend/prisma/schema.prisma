// Digital History Teacher — ma'lumotlar bazasi sxemasi (PostgreSQL + Prisma)
// Izoh: kompetensiya komponentlari, darajalar va vaznlar — DOCX hujjatda taklif
// qilingan ISHCHI MODEL. Ular admin panelidan sozlanadi va eksperimental
// tasdiqlangan ilmiy natija sifatida ko'rsatilmaydi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enumlar ─────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum PublicationStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

enum SourceType {
  WRITTEN
  VISUAL
  MAP
  AUDIO
  VIDEO
  ARCHAEOLOGICAL
}

enum VirtualObjectType {
  MODEL_3D
  TOUR_360
  VIRTUAL_MUSEUM
  OTHER
}

enum EmbedProvider {
  SKETCHFAB
  UZBEKISTAN360
  OTHER
}

enum VirtualTaskKind {
  OBSERVATION
  EVIDENCE
  COMPARISON
  DISCUSSION
  LESSON_APPLICATION
  MATERIAL_CREATION
}

enum WorkStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  REVIEWED
}

/// Pedagogik eksperiment uchun guruh turi (hujjat, 5-bo'lim)
enum GroupKind {
  REGULAR
  EXPERIMENTAL
  CONTROL
}

enum PortfolioItemType {
  ASSIGNMENT
  SOURCE_ANALYSIS
  SOURCE_COMPARISON
  LESSON_PLAN
  VIRTUAL_WORK
  DIAGNOSTIC
  SELF_ASSESSMENT
  REFLECTION
  /// Talaba o'zi yuklagan fayl (refType = MediaFile)
  UPLOAD
}

// ───────────────────────── Foydalanuvchilar ─────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Tizimga kirish uchun login (kichik harflarda saqlanadi)
  username     String     @unique
  /// Ixtiyoriy aloqa manzili
  email        String?    @unique
  passwordHash String
  fullName     String
  role         Role       @default(STUDENT)
  status       UserStatus @default(PENDING)
  institution  String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  refreshTokens            RefreshToken[]
  passwordResets           PasswordResetToken[]
  teachingGroups           Group[]                 @relation("GroupTeacher")
  memberships              GroupMembership[]
  createdSources           HistoricalSource[]      @relation("SourceCreator")
  createdObjects           VirtualObject[]         @relation("ObjectCreator")
  virtualResponses         VirtualObjectResponse[]
  reviewedVirtualResponses VirtualObjectResponse[] @relation("VirtualResponseReviewer")
  createdTests             Test[]                  @relation("TestCreator")
  testAttempts             TestAttempt[]
  lessonPlans              LessonPlan[]            @relation("LessonAuthor")
  reviewedLessons          LessonPlan[]            @relation("LessonReviewer")
  portfolio                Portfolio?
  reflections              ReflectionEntry[]
  mediaFiles               MediaFile[]
  auditLogs                AuditLog[]

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Guruhlar ───────────────────────────

model Group {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  kind         GroupKind @default(REGULAR)
  academicYear String?
  teacherId    String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  teacher User              @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  members GroupMembership[]

  @@index([teacherId])
}

model GroupMembership {
  groupId   String   @db.Uuid
  studentId String   @db.Uuid
  joinedAt  DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId])
}

// ─────────────────────── Tarixiy davr va mavzular ───────────────────────

model HistoricalPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  /// Taxminiy yillar (manfiy = mil. avv.). Ixtiyoriy.
  startYear   Int?
  endYear     Int?
  description String?
  /// Davr chegaralari uchun manba/izoh
  reference   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics         HistoricalTopic[]
  sources        HistoricalSource[]
  virtualObjects VirtualObject[]
}

model HistoricalTopic {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  periodId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  period      HistoricalPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  sources     SourceTopic[]
  lessonPlans LessonPlan[]

  @@index([periodId])
}

// ─────────────────────── Media fayllar ───────────────────────

/// Fayl mazmuni bazada (STORAGE_DRIVER=database) — Render free kabi diski vaqtinchalik hostinglar uchun.
/// MediaFile.storageKey bilan bog'lanadi (MediaFile.storage = "database")
model StoredFile {
  key       String   @id
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

model MediaFile {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  /// Storage ichidagi kalit (lokal disk fayl nomi yoki S3 key)
  storageKey   String   @unique
  storage      String   @default("local")
  mimeType     String
  size         Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  uploadedBy          User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  sourceCovers        HistoricalSource[] @relation("SourceCover")
  sourceLectures      HistoricalSource[] @relation("SourceLectureFile")
  sourcePresentations HistoricalSource[] @relation("SourcePresentation")
  sourceVideos        HistoricalSource[] @relation("SourceVideo")
  tests               Test[]

  translationLectures      HistoricalSourceTranslation[] @relation("TranslationLectureFile")
  translationPresentations HistoricalSourceTranslation[] @relation("TranslationPresentation")
  translationVideos        HistoricalSourceTranslation[] @relation("TranslationVideo")
}

// ─────────────────────── 1-modul: Manbalar (ma'ruza mavzulari) ───────────────────────

/// Kutubxonadagi har bir yozuv — bitta o'quv mavzusi: ma'ruza matni, taqdimot va video rolik

model HistoricalSource {
  id                        String            @id @default(uuid()) @db.Uuid
  title                     String
  slug                      String            @unique
  summary                   String
  description               String?
  type                      SourceType
  format                    String?
  periodId                  String?           @db.Uuid
  /// Insonga tushunarli sana (masalan: "XV asr boshi")
  dateLabel                 String?
  yearFrom                  Int?
  yearTo                    Int?
  author                    String?
  origin                    String?
  repository                String?
  originalUrl               String?
  license                   String?
  copyright                 String?
  reliabilityNotes          String?
  limitations               String?
  notes                     String?
  teachingUse               String?
  methodicalRecommendations String?
  /// Manba asosida bajariladigan amaliy topshiriqlar — har bir qatorda bitta topshiriq (hujjat, 1-modul)
  practicalTasks            String?
  /// Foydalanilgan adabiyotlar va manbalar — har qatorda bitta; havola bo'lsa "Nomi — https://..." ko'rinishida
  references                String?
  mediaUrl                  String?
  embedUrl                  String?
  mediaFileId               String?           @db.Uuid
  latitude                  Float?
  longitude                 Float?
  /// Ro'yxatdagi tartib (darslik bo'yicha mavzu ketma-ketligi)
  sortOrder                 Int               @default(0)
  /// Qaysi darslik va mavzu asosida (masalan: "O'zbekiston tarixi, I kitob · 12-mavzu")
  bookLabel                 String?
  /// Ma'ruza matni (Markdown) — sahifada o'qiladi, chop etiladi/PDF saqlanadi
  lectureContent            String?
  /// Ixtiyoriy: ma'ruzaning rasmiy fayli (DOCX/PDF) yuklab olish uchun
  lectureFileId             String?           @db.Uuid
  /// Mavzuga tegishli taqdimot (PPTX/PDF)
  presentationFileId        String?           @db.Uuid
  /// Video rolik: yuklangan fayl yoki YouTube havolasi
  videoFileId               String?           @db.Uuid
  videoUrl                  String?
  /// Demo yozuv — ma'lumotlarni admin/ekspert tekshirishi kerak
  isDemo                    Boolean           @default(false)
  status                    PublicationStatus @default(DRAFT)
  createdById               String?           @db.Uuid
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  period           HistoricalPeriod?             @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdBy        User?                         @relation("SourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mediaFile        MediaFile?                    @relation("SourceCover", fields: [mediaFileId], references: [id], onDelete: SetNull)
  lectureFile      MediaFile?                    @relation("SourceLectureFile", fields: [lectureFileId], references: [id], onDelete: SetNull)
  presentationFile MediaFile?                    @relation("SourcePresentation", fields: [presentationFileId], references: [id], onDelete: SetNull)
  videoFile        MediaFile?                    @relation("SourceVideo", fields: [videoFileId], references: [id], onDelete: SetNull)
  topics           SourceTopic[]
  /// Boshqa tillardagi (ru, en) variantlari; asosiy maydonlar o'zbekcha (uz)
  translations     HistoricalSourceTranslation[]
  /// Kitob (PDF) bo'lsa — sahifalar matni, qidiruv uchun
  pages            SourcePage[]
  virtualObjects   VirtualObjectSource[]
  lessonResources  LessonResource[]
  tests            Test[]

  @@index([type, status])
  @@index([periodId])
  @@index([deletedAt])
}

/// Mavzuning boshqa tildagi varianti. Faqat tilga bog'liq maydonlar; davr, yil, muqova, koordinata — asosiy yozuvda.
/// Bo'sh (null) maydon uchun o'zbekcha qiymat ko'rsatiladi.
model HistoricalSourceTranslation {
  id                        String   @id @default(uuid()) @db.Uuid
  sourceId                  String   @db.Uuid
  /// "ru" | "en"
  locale                    String
  title                     String
  summary                   String?
  description               String?
  teachingUse               String?
  methodicalRecommendations String?
  practicalTasks            String?
  references                String?
  lectureContent            String?
  lectureFileId             String?  @db.Uuid
  presentationFileId        String?  @db.Uuid
  videoFileId               String?  @db.Uuid
  videoUrl                  String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  source           HistoricalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  lectureFile      MediaFile?       @relation("TranslationLectureFile", fields: [lectureFileId], references: [id], onDelete: SetNull)
  presentationFile MediaFile?       @relation("TranslationPresentation", fields: [presentationFileId], references: [id], onDelete: SetNull)
  videoFile        MediaFile?       @relation("TranslationVideo", fields: [videoFileId], references: [id], onDelete: SetNull)

  @@unique([sourceId, locale])
}

/// Bazada o'zbekcha saqlangan ixtiyoriy matnning (davr/mavzu/obyekt nomi, tavsif, metod nomi va h.k.) boshqa tildagi varianti.
/// Kalit — o'zbekcha matnning md5 hash'i (uzun matnlar ham sig'adi); API javobida aynan shu matn topilsa, almashtiriladi.
model TextTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  sourceHash String
  /// O'zbekcha asl matn (ma'lumot uchun)
  source     String
  /// "ru" | "en"
  locale     String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceHash, locale])
}

/// Kitob PDF'ining bitta sahifasi matni (qidiruv natijasi shu sahifaga yo'naltiradi)
model SourcePage {
  id       String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  /// PDF ko'ruvchidagi sahifa raqami (1 dan)
  page     Int
  text     String

  source HistoricalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, page])
}

model SourceTopic {
  sourceId String @db.Uuid
  topicId  String @db.Uuid

  source HistoricalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  topic  HistoricalTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([sourceId, topicId])
  @@index([topicId])
}

// ─────────────────────── 4-modul: Virtual muzey (3D va 360) ───────────────────────

model VirtualObject {
  id                        String            @id @default(uuid()) @db.Uuid
  title                     String
  slug                      String            @unique
  type                      VirtualObjectType
  provider                  EmbedProvider     @default(OTHER)
  periodId                  String?           @db.Uuid
  periodLabel               String?
  location                  String?
  /// Koordinatalar faqat ishonchli ma'lum bo'lsa kiritiladi
  latitude                  Float?
  longitude                 Float?
  description               String
  historicalSignificance    String?
  externalUrl               String
  /// Server tomonida ruxsat etilgan hostlar ro'yxati bilan tekshiriladi
  embedUrl                  String?
  authorOrOrganization      String?
  license                   String?
  termsNote                 String?
  historicalReferences      String?
  methodicalRecommendations String?
  thumbnailUrl              String?
  isDemo                    Boolean           @default(false)
  isActive                  Boolean           @default(true)
  status                    PublicationStatus @default(DRAFT)
  createdById               String?           @db.Uuid
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  period          HistoricalPeriod?       @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation("ObjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sources         VirtualObjectSource[]
  tasks           VirtualObjectTask[]
  responses       VirtualObjectResponse[]
  lessonResources LessonResource[]

  @@index([type, status, isActive])
}

model VirtualObjectSource {
  virtualObjectId String @db.Uuid
  sourceId        String @db.Uuid

  virtualObject VirtualObject    @relation(fields: [virtualObjectId], references: [id], onDelete: Cascade)
  source        HistoricalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([virtualObjectId, sourceId])
}

model VirtualObjectTask {
  id              String          @id @default(uuid()) @db.Uuid
  virtualObjectId String          @db.Uuid
  kind            VirtualTaskKind
  prompt          String
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())

  virtualObject VirtualObject @relation(fields: [virtualObjectId], references: [id], onDelete: Cascade)

  @@index([virtualObjectId])
}

model VirtualObjectResponse {
  id              String     @id @default(uuid()) @db.Uuid
  studentId       String     @db.Uuid
  virtualObjectId String     @db.Uuid
  /// Javoblar: taskId -> matn
  answers         Json
  /// Obyekt asosida tuzilgan mashg'ulot g'oyasi
  activityDesign  String     @default("")
  status          WorkStatus @default(DRAFT)
  teacherComment  String?
  score           Float?
  reviewedById    String?    @db.Uuid
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("VirtualResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  virtualObject VirtualObject @relation(fields: [virtualObjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, virtualObjectId])
}

// ─────────────────────── Topshiriqlar: fayl asosidagi test ───────────────────────

/// O'qituvchi test faylini (PDF/DOCX) yuklaydi va javoblar kalitini belgilaydi.
/// Talaba faylni o'qib, har bir savolga A/B/C/D javobini belgilaydi.
model Test {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  /// Test qaysi mavzuga tegishli (kutubxonadagi mavzu)
  sourceId      String?   @db.Uuid
  fileId        String    @db.Uuid
  questionCount Int
  /// To'g'ri javoblar: ["A", "C", ...] — uzunligi questionCount ga teng
  answerKey     Json
  isPublished   Boolean   @default(true)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  source    HistoricalSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  file      MediaFile         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User?             @relation("TestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attempts  TestAttempt[]

  @@index([sourceId])
  @@index([deletedAt, isPublished])
}

/// Talabaning test natijasi — bitta test uchun bitta urinish (o'qituvchi o'chirsa, qayta topshiradi)
model TestAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  testId       String   @db.Uuid
  studentId    String   @db.Uuid
  /// Talaba javoblari: ["A", null, "D", ...]
  answers      Json
  correctCount Int
  total        Int
  /// 0–100
  percent      Float
  submittedAt  DateTime @default(now())

  test    Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@index([studentId])
}

// ─────────────────────── 3-modul: Dars konstruktori ───────────────────────

model LessonPlan {
  id                  String     @id @default(uuid()) @db.Uuid
  authorId            String     @db.Uuid
  title               String
  topic               String
  /// Katalogdagi mavzu — platforma unga mos manbalarni taklif qiladi (hujjat, 3-modul)
  topicId             String?    @db.Uuid
  gradeLevel          String
  durationMinutes     Int        @default(45)
  goals               String     @default("")
  objectives          String     @default("")
  learningOutcomes    String     @default("")
  /// Matnlar ro'yxati (JSON massiv)
  problemQuestions    Json       @default("[]")
  individualTasks     String     @default("")
  groupTasks          String     @default("")
  /// Matnlar ro'yxati (JSON massiv)
  interactiveMethods  Json       @default("[]")
  assessmentCriteria  String     @default("")
  reflectionQuestions String     @default("")
  methodicalRationale String     @default("")
  status              WorkStatus @default(DRAFT)
  currentVersion      Int        @default(1)
  teacherComment      String?
  score               Float?
  reviewedById        String?    @db.Uuid
  submittedAt         DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  topicRef   HistoricalTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author     User                @relation("LessonAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("LessonReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  stages     LessonStage[]
  resources  LessonResource[]
  versions   LessonPlanVersion[]

  @@index([authorId, status])
}

model LessonStage {
  id              String @id @default(uuid()) @db.Uuid
  lessonPlanId    String @db.Uuid
  sortOrder       Int
  title           String
  durationMinutes Int
  teacherActivity String @default("")
  studentActivity String @default("")
  methods         String @default("")
  resources       String @default("")

  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
}

model LessonResource {
  id              String  @id @default(uuid()) @db.Uuid
  lessonPlanId    String  @db.Uuid
  sourceId        String? @db.Uuid
  virtualObjectId String? @db.Uuid
  purpose         String  @default("")

  lessonPlan    LessonPlan        @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  source        HistoricalSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  virtualObject VirtualObject?    @relation(fields: [virtualObjectId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
}

model LessonPlanVersion {
  id           String   @id @default(uuid()) @db.Uuid
  lessonPlanId String   @db.Uuid
  version      Int
  snapshot     Json
  note         String?
  createdAt    DateTime @default(now())

  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, version])
}

// ─────────────────────── 7-modul: Portfolio ───────────────────────

model Portfolio {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @unique @db.Uuid
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   PortfolioItem[]
}

model PortfolioItem {
  id          String            @id @default(uuid()) @db.Uuid
  portfolioId String            @db.Uuid
  type        PortfolioItemType
  title       String
  description String?
  /// Bog'langan obyekt turi: SourceAnalysis, LessonPlan, AssignmentSubmission ...
  refType     String
  refId       String            @db.Uuid
  /// Ish bog'langan tarixiy manbalar
  sourceIds   String[]          @db.Uuid
  version     Int               @default(1)
  isFeatured  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, refType, refId])
  @@index([portfolioId, type])
}

model ReflectionEntry {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  title       String
  content     String
  relatedType String?
  relatedId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ─────────────────────── Tizim ───────────────────────

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

/// «Muallif va bog'lanish» sahifasidagi forma xabarlari — admin panelda «Xabarlar» bo'limida ko'rinadi
model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}
