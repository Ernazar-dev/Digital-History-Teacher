NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dht:<POSTGRES_PASSWORD>@localhost:5433/digital_history_teacher?schema=public
# Test bazasi (vitest integratsion testlari uchun alohida baza)
TEST_DATABASE_URL=postgresql://dht:<POSTGRES_PASSWORD>@localhost:5433/digital_history_teacher_test?schema=public

# Kamida 32 belgili tasodifiy qatorlar. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Vergul bilan ajratilgan ruxsat etilgan frontend originlar
CORS_ORIGINS=http://localhost:5173

# Embed qilishga ruxsat etilgan hostlar (server tomonida tekshiriladi)
EMBED_ALLOWED_HOSTS=sketchfab.com,uzbekistan360.uz

# Auth (login/ro‘yxat/parol tiklash) uchun 15 daqiqadagi urinishlar limiti.
# IP bo'yicha 15 daqiqada (butun sinf bitta IP dan kirishi mumkin). Hisob bo'yicha alohida blok: 5 xato parol -> 15 daqiqa.
AUTH_RATE_LIMIT_MAX=100

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10
# Yuklangan fayllar qayerda saqlanadi: local — disk (UPLOAD_DIR); database — PostgreSQL.
# Render free kabi diski vaqtinchalik hostinglarda "database" qo'ying (aks holda fayllar qayta deployda yo'qoladi).
STORAGE_DRIVER=local
# Server oldidagi proxy'lar soni (to'g'ri IP aniqlash uchun). Lokal/nginx: 1; Render + frontend rewrite: 2
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# ── Administrator paneli (login va parol FAQAT shu yerda saqlanadi) ──
# Server har ishga tushganda shu hisobni yaratadi, rolini ADMIN qiladi va parolini
# shu qiymat bilan sinxronlaydi. Parolni almashtirish — shu qatorni o'zgartirib serverni qayta ishga tushirish.
# Parol kamida 10 belgi; productionda "change-me" bilan boshlanadigan qiymat taqiqlangan.
# Login: 3–32 belgi — lotin harflari, raqamlar, "." "_" "-" (email shart emas)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_FULL_NAME=Administrator

# ── Demo hisoblar (faqat development: SEED_DEMO_USERS=true va NODE_ENV≠production) ──
SEED_DEMO_USERS=true
DEMO_TEACHER_USERNAME=teacher
DEMO_TEACHER_PASSWORD=change-me-teacher-password
# Aynan 3 ta login (2 tasi tajriba, 1 tasi nazorat guruhiga qo'shiladi)
DEMO_STUDENT_USERNAMES=student1,student2,student3
DEMO_STUDENT_PASSWORD=change-me-student-password

# ── Tashqariga ko'rinadigan xizmat ma'lumotlari ──
# Swagger API hujjati (/api/docs). Ko'rsatilmasa: productionda o'chiq, developmentda yoqiq.
API_DOCS_ENABLED=false
# Parol tiklash tokenini API javobida qaytarish (email servisi ulanmaguncha). Productionda har doim o'chiq.
EXPOSE_RESET_TOKEN=true
